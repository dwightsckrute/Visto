<?xml version="1.0" encoding="utf-8"?>
<!--
    Capa frontal del icono.

    Deliberadamente pobre en piezas. La versión anterior tenía cinco: cuerpo, banda inferior, dos
    pestañas y una insignia circular oscura con su check encima. El generador de iconos con IA del
    launcher la rechazaba con SAFETY_FILTER_VIOLATION —igual que hace con Firefox, así que no es
    un defecto nuestro sino un falso positivo de su filtro—, y lo único sobre lo que se puede
    actuar desde aquí es la imagen que le entra. Menos formas, ninguna superpuesta y nada que
    pueda leerse como una figura.

    Sigue siendo lo mismo: una pantalla y una marca de visto.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- La pantalla. Dentro de la zona segura de 66dp (21..87) por los cuatro lados. -->
    <path
        android:fillColor="#C9CCFF"
        android:pathData="M36,30 L72,30 Q84,30 84,42 L84,66 Q84,78 72,78 L36,78 Q24,78 24,66 L24,42 Q24,30 36,30 Z" />
    <!-- La marca, hueca sobre la pantalla: un solo trazo, sin piezas encima. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M39,55 L49,65 L69,43"
        android:strokeColor="#4C57A9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="9" />
</vector>
